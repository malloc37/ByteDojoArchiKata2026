        <mxCell id="n17" value="Animal Anomaly Detected&#xa;Staffing Recommended" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;strokeColor=#C2761A;fontColor=#8A4B00;fontSize=10;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="n7" target="n8">
          <mxGeometry relative="1" as="geometry">
