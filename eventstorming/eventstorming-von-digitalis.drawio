        </mxCell>
        <mxCell id="n18" value="Request Animal Inspection&#xa;(a person decides, not the model)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#5A5A5A;labelBackgroundColor=#FFFFFF;strokeColor=#C2761A;fontColor=#8A4B00;fontSize=10;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.75;entryY=1;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="n8" target="n5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="450" />
              <mxPoint x="1250" y="800" />
              <mxPoint x="307" y="800" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n19" value="Reading the map&#xa;&#xa;•  Ticketing issues, Admission validates. Ticketing never opens a gate.&#xa;&#xa;•  Ride Operations and Animal and Enclosure Care own real availability.&#xa;    Attraction Catalogue publishes it and cannot override a closure.&#xa;&#xa;•  Estate Insights consumes facts only. Every consequential finding&#xa;    leaves as a task or an alert for a person, never as a direct command.&#xa;&#xa;•  Staff Tasks and Alerts is the only path from a policy to human work." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#444444;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1340" y="70" width="430" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
