<mxfile host="app.diagrams.net" type="device" agent="archikata"><diagram name="AI decision-support pattern"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7121" value="AI decision-support pattern" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="7122" value="Every AI use case follows this pipeline. Facts in, a recommendation out, a person decides." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="7123" value="Estate Insights and AI Decision Support" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDF0F5;strokeColor=#C079A0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#6B3352;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="1160" height="300" as="geometry"/></mxCell><mxCell id="7124" value="Staff Tasks and Alerts, then the owning domain" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F1F1F4;strokeColor=#8A8A99;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3A3A45;" vertex="1" parent="1"><mxGeometry x="420" y="470" width="1070" height="170" as="geometry"/></mxCell><mxCell id="7125" value="Recorded facts&#10;domain events from the&#10;operational contexts" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;size=10;" vertex="1" parent="1"><mxGeometry x="60" y="195" width="230" height="110" as="geometry"/></mxCell><mxCell id="7126" value="Task-shaped interface&#10;e.g. detect animal anomaly" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="355" y="215" width="220" height="70" as="geometry"/></mxCell><mxCell id="7127" value="Model or rule&#10;versioned, replaceable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#2A1733;" vertex="1" parent="1"><mxGeometry x="630" y="215" width="220" height="70" as="geometry"/></mxCell><mxCell id="7128" value="confidence&#10;above&#10;threshold?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="905" y="190" width="180" height="120" as="geometry"/></mxCell><mxCell id="7129" value="Abstention recorded&#10;no task is created" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="900" y="345" width="190" height="70" as="geometry"/></mxCell><mxCell id="71210" value="Recommendation record&#10;confidence, model version,&#10;source events, created at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1160" y="205" width="290" height="100" as="geometry"/></mxCell><mxCell id="71211" value="Task or alert&#10;for a named role" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="1200" y="500" width="250" height="80" as="geometry"/></mxCell><mxCell id="71212" value="Responsible person&#10;accepts, rejects or corrects" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="850" y="500" width="250" height="80" as="geometry"/></mxCell><mxCell id="71213" value="Outcome recorded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="505" width="230" height="70" as="geometry"/></mxCell><mxCell id="71214" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="7125" target="7126"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71215" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="7126" target="7127"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71216" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="7127" target="7128"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71217" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="7128" target="71210"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71218" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="7128" target="7129"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71219" value="consequential findings only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="71210" target="71211"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71220" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="71211" target="71212"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71221" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="71212" target="71213"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71222" value="recorded as a fact,&#10;and as evaluation data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;dashed=1;dashPattern=8 5;strokeColor=#B06A00;fontColor=#8A4B00;strokeWidth=2;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="71213" target="7125"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="540"/></Array></mxGeometry></mxCell><mxCell id="71223" value="Never: an AI output issuing a command that changes a payment, an admission, a ride state&#10;or an animal-care record. Authority stays with deterministic rules and people. (ADR-003)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="720" height="80" as="geometry"/></mxCell><mxCell id="71224" value="Provider unavailable: no recommendation is produced.&#10;Estate operations are unaffected, because nothing waits on a model. (ADR-010)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="820" y="690" width="670" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC-1 Animal health anomaly"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6721" value="UC-1  Animal health anomaly detection" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="6722" value="Animals are costly, and far more costly once one is sick. 200 animals across 55 enclosures is more than keepers can watch at all times." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="6723" value="Reads&#10;&#10;Animal fed&#10;food offered and consumed&#10;&#10;Animal Inspected&#10;&#10;Enclosure sensor readings&#10;environment and activity&#10;&#10;Enclosure Population Changed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="260" height="190" as="geometry"/></mxCell><mxCell id="6724" value="Detect animal anomaly" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="370" y="205" width="230" height="80" as="geometry"/></mxCell><mxCell id="6725" value="confidence&#10;above&#10;threshold?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="6726" value="Abstention recorded&#10;&#10;Also abstains when the recent&#10;observation window is incomplete,&#10;for example after an outage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="230" height="90" as="geometry"/></mxCell><mxCell id="6727" value="Animal Anomaly Detected&#10;confidence, model version,&#10;source events, created at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="280" height="120" as="geometry"/></mxCell><mxCell id="6728" value="Zookeeper&#10;reviews the inspection task&#10;and records confirmed,&#10;not confirmed, or other cause" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="6729" value="Nothing changes&#10;until the keeper&#10;records an inspection.&#10;No diagnosis is produced." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1520" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="67210" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6723" target="6724"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67211" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6724" target="6725"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67212" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6725" target="6727"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67213" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="6725" target="6726"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67214" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6727" target="6728"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67215" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6728" target="6729"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67216" value="Cost of being wrong&#10;&#10;A missed anomaly means late detection, so this is not the only safety net.&#10;A false alarm costs keeper time, which is why precision sets the threshold." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="67217" value="Works without AI&#10;&#10;The deterministic overdue-feeding rule (FR-AE-11) and scheduled keeper rounds&#10;run with no AI involved. Care recording works during an estate outage." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="67218" value="Measured by&#10;&#10;Precision and recall against keeper-confirmed outcomes on the ground-truth set.&#10;Share of alerts a keeper accepts. See ADR-011." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="550" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC-2 Crowd forecast and staffing"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1241" value="UC-2  Crowd forecasting and staffing" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="1242" value="The Countess needs to know where to invest and where to deploy staff, with visitor numbers expected to triple." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="1243" value="Reads&#10;&#10;Park Entered and Park Left&#10;&#10;Visitor entered / left park area&#10;&#10;Area visitor count changed&#10;&#10;Attraction entered,&#10;queue entry and exit&#10;&#10;Comparable past days" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="260" height="190" as="geometry"/></mxCell><mxCell id="1244" value="Forecast crowding and&#10;recommend staffing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="370" y="205" width="230" height="80" as="geometry"/></mxCell><mxCell id="1245" value="enough recent&#10;counting data?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="1246" value="Abstention recorded&#10;&#10;Happens when the counting&#10;window has gaps, after an&#10;outage or a missing device" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="230" height="90" as="geometry"/></mxCell><mxCell id="1247" value="Crowd Forecast Produced&#10;Staffing Recommended&#10;with confidence and provenance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="280" height="120" as="geometry"/></mxCell><mxCell id="1248" value="Operations Manager&#10;accepts, rejects or corrects,&#10;and the outcome is recorded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="1249" value="Nothing changes&#10;until the manager&#10;acts on it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1520" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="12410" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1243" target="1244"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12411" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1244" target="1245"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12412" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1245" target="1247"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12413" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1245" target="1246"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12414" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1247" target="1248"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12415" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1248" target="1249"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12416" value="Cost of being wrong&#10;&#10;Under-staffing or over-staffing for a shift. No safety consequence, because&#10;the crowding response is deterministic and entirely separate from this." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="12417" value="Works without AI&#10;&#10;The Area Capacity Exceeded policy runs at the edge and notifies operations&#10;whether or not a forecast exists (ADR-006). Crowding never waits on a model." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="12418" value="Measured by&#10;&#10;Forecast error against actual counts per area. Acceptance rate of staffing&#10;recommendations. Works on anonymous counts, see QA-04." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="550" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC-3 Visitor itinerary"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="9661" value="UC-3  Visitor itinerary recommendation" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="9662" value="The estate needs to grow visitor numbers, and the brief asks for AI that helps customers and not only the company." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="9663" value="Reads&#10;&#10;Published attraction availability&#10;from the Attraction Catalogue&#10;&#10;Current queue lengths&#10;&#10;Crowding forecast from UC-2&#10;&#10;Visitor preferences&#10;where consent exists" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="260" height="190" as="geometry"/></mxCell><mxCell id="9664" value="Recommend itinerary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="370" y="205" width="230" height="80" as="geometry"/></mxCell><mxCell id="9665" value="fresh data and&#10;consent present?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="9666" value="Abstention recorded&#10;&#10;The app falls back to the&#10;plain attraction list, which&#10;is not an AI feature" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="230" height="90" as="geometry"/></mxCell><mxCell id="9667" value="Itinerary Recommended&#10;shown in the visitor application" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="280" height="120" as="geometry"/></mxCell><mxCell id="9668" value="The visitor&#10;follows it or ignores it.&#10;No staff review, the&#10;consequence is low." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="9669" value="Advice only.&#10;Nothing operational&#10;changes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1520" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="96610" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9663" target="9664"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96611" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9664" target="9665"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96612" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9665" target="9667"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96613" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="9665" target="9666"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96614" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9667" target="9668"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96615" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9668" target="9669"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96616" value="Cost of being wrong&#10;&#10;A mediocre route. A closed attraction can never appear, because that is&#10;checked deterministically before the itinerary is shown, not left to the model." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="96617" value="Works without AI&#10;&#10;Catalogue availability is authoritative and a safety closure always wins&#10;(FR-AC-05). Without AI the visitor gets the ordinary attraction list." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="96618" value="Measured by&#10;&#10;Share of recommendations a visitor follows.&#10;100 per cent pass rate on the closed-attraction check." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="550" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>