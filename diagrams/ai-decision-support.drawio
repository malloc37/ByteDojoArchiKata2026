<mxfile host="app.diagrams.net" type="device" agent="archikata"><diagram name="AI decision-support pattern"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7121" value="AI decision-support pattern" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="7122" value="Every AI use case follows this pipeline. Facts in, a recommendation out, a person decides." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="7123" value="Estate Insights and AI Decision Support" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDF0F5;strokeColor=#C079A0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#6B3352;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="1160" height="300" as="geometry"/></mxCell><mxCell id="7124" value="Staff Tasks and Alerts, then the owning domain" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F1F1F4;strokeColor=#8A8A99;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3A3A45;" vertex="1" parent="1"><mxGeometry x="420" y="470" width="1070" height="170" as="geometry"/></mxCell><mxCell id="7125" value="Recorded facts&#10;domain events from the&#10;operational contexts" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;size=10;" vertex="1" parent="1"><mxGeometry x="60" y="195" width="230" height="110" as="geometry"/></mxCell><mxCell id="7126" value="Task-shaped interface&#10;e.g. detect animal anomaly" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="355" y="215" width="220" height="70" as="geometry"/></mxCell><mxCell id="7127" value="Model or rule&#10;LLM with a non-LLM&#10;baseline (ADR-017)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#2A1733;" vertex="1" parent="1"><mxGeometry x="630" y="215" width="220" height="70" as="geometry"/></mxCell><mxCell id="7128" value="calibrated&#10;confidence above&#10;threshold?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="905" y="190" width="180" height="120" as="geometry"/></mxCell><mxCell id="7129" value="Abstention recorded&#10;no task is created" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="900" y="345" width="190" height="70" as="geometry"/></mxCell><mxCell id="71210" value="Recommendation record&#10;confidence, model version,&#10;source events, created at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1160" y="205" width="290" height="100" as="geometry"/></mxCell><mxCell id="71211" value="Task or alert&#10;for a named role" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="1200" y="500" width="250" height="80" as="geometry"/></mxCell><mxCell id="71212" value="Responsible person&#10;accepts, rejects or corrects" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="850" y="500" width="250" height="80" as="geometry"/></mxCell><mxCell id="71213" value="Outcome recorded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="505" width="230" height="70" as="geometry"/></mxCell><mxCell id="71214" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="7125" target="7126"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71215" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="7126" target="7127"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71216" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="7127" target="7128"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71217" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="7128" target="71210"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71218" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="7128" target="7129"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71219" value="consequential findings only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="71210" target="71211"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71220" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="71211" target="71212"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71221" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="71212" target="71213"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="71222" value="recorded as a fact,&#10;and as evaluation data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;dashed=1;dashPattern=8 5;strokeColor=#B06A00;fontColor=#8A4B00;strokeWidth=2;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="71213" target="7125"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="540"/></Array></mxGeometry></mxCell><mxCell id="71223" value="Never: an AI output issuing a command that changes a payment, an admission, a ride state&#10;or an animal-care record. Authority stays with deterministic rules and people. (ADR-003)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="720" height="80" as="geometry"/></mxCell><mxCell id="71224" value="Provider unavailable: no recommendation is produced.&#10;Estate operations are unaffected, because nothing waits on a model. (ADR-010)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="820" y="690" width="670" height="80" as="geometry"/></mxCell><mxCell id="lgpk" value="Key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#3A3A3A;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="1430" height="130" as="geometry"/></mxCell><mxCell id="lgps0" value="" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;size=4;" vertex="1" parent="1"><mxGeometry x="72" y="836" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt0" value="Recorded facts" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="832" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9BD5F0;strokeColor=#4D8FAD;" vertex="1" parent="1"><mxGeometry x="424" y="836" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt1" value="Interface, or a task for a person" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="832" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="777" y="836" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt2" value="Model or rule" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="823" y="832" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps3" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1130" y="836" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt3" value="Decision gate" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1176" y="832" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0F0F0;strokeColor=#8C8C8C;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="72" y="866" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt4" value="Abstention, recorded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="862" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFB366;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="424" y="866" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt5" value="Record or event" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="862" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2D0;strokeColor=#B99326;" vertex="1" parent="1"><mxGeometry x="777" y="866" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt6" value="Responsible person" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="823" y="862" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps7" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF0F5;strokeColor=#C079A0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1130" y="866" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt7" value="Estate Insights module" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1176" y="862" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F1F1F4;strokeColor=#8A8A99;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="72" y="896" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt8" value="Staff Tasks, then owning domain" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="892" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps9" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="424" y="896" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt9" value="Never allowed" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="892" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps10" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="777" y="896" width="36" height="18" as="geometry"/></mxCell><mxCell id="lgpt10" value="Degraded mode" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="823" y="892" width="298" height="26" as="geometry"/></mxCell><mxCell id="lgps11" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#B06A00;strokeWidth=2;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="905" as="sourcePoint"/><mxPoint x="1166" y="905" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgpt11" value="Outcome fed back as evaluation data" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1176" y="892" width="298" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC-1 Animal health anomaly"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6721" value="UC-1  Animal health anomaly detection" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="6722" value="Animals are costly, and far more costly once one is sick. 200 animals across 55 enclosures is more than keepers can watch at all times." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="6723" value="Reads&#10;&#10;Animal fed&#10;food offered and consumed&#10;&#10;Animal Inspected&#10;&#10;Enclosure sensor readings&#10;environment and activity&#10;&#10;Enclosure Population Changed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="260" height="190" as="geometry"/></mxCell><mxCell id="6724" value="Detect animal anomaly&#10;LLM over feeding data,&#10;sensors and keeper notes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="370" y="205" width="230" height="80" as="geometry"/></mxCell><mxCell id="6725" value="calibrated&#10;confidence above&#10;threshold?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="6726" value="Abstention recorded&#10;&#10;Also abstains when the recent&#10;observation window is incomplete,&#10;for example after an outage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="230" height="90" as="geometry"/></mxCell><mxCell id="6727" value="Animal Anomaly Detected&#10;confidence, model version,&#10;source events, created at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="280" height="120" as="geometry"/></mxCell><mxCell id="6728" value="Zookeeper&#10;reviews the inspection task&#10;and records confirmed,&#10;not confirmed, or other cause" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="6729" value="Nothing changes&#10;until the keeper&#10;records an inspection.&#10;No diagnosis is produced." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1520" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="67210" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6723" target="6724"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67211" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6724" target="6725"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67212" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6725" target="6727"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67213" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="6725" target="6726"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67214" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6727" target="6728"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67215" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6728" target="6729"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="67216" value="Cost of being wrong&#10;&#10;A missed anomaly means late detection, so this is not the only safety net.&#10;A false alarm costs keeper time, but a miss costs more, so the threshold favours recall (ADR-011)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="67217" value="Works without AI&#10;&#10;The deterministic overdue-feeding rule (FR-AE-11) and scheduled keeper rounds&#10;run with no AI involved. Care recording works during an estate outage." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="67218" value="Measured by&#10;&#10;Recall, with a precision floor, against keeper-confirmed outcomes on the test set.&#10;After release: share of alerts a keeper confirms on inspection, and anomalies&#10;found on rounds with no prior alert. See ADR-011." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="lg1k" value="Key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#3A3A3A;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1710" height="100" as="geometry"/></mxCell><mxCell id="lg1s0" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="72" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg1t0" value="Recorded facts the use case reads" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg1s1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9BD5F0;strokeColor=#4D8FAD;" vertex="1" parent="1"><mxGeometry x="410" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg1t1" value="AI step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg1s2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="748" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg1t2" value="Decision gate" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg1s3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0F0F0;strokeColor=#8C8C8C;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1086" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg1t3" value="Abstention, recorded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg1s4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFB366;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1424" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg1t4" value="Recommendation event" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1470" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg1s5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2D0;strokeColor=#B99326;" vertex="1" parent="1"><mxGeometry x="72" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg1t5" value="Person who reviews or decides" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg1s6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="410" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg1t6" value="What changes, or what works without AI" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg1s7" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBE3E2;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="748" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg1t7" value="Cost of being wrong" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg1s8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1086" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg1t8" value="How it is measured" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="uc1spec" value="What is specific to UC-1&#10;&#10;Observation window: recent days against the animal's own four-week history.&#10;Gaps: a stale sensor or missing feedings means abstain, with the reason recorded.&#10;Confidence: share of five runs that flag the animal, calibrated (ADR-017).&#10;The keeper's inspection outcome feeds evaluation. Delivery: ai-task-delivery.png" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="870" height="145" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC-2 Crowd forecast and staffing"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1241" value="UC-2  Crowd forecasting and staffing" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="1242" value="The Countess needs to know where to invest and where to deploy staff, with visitor numbers expected to triple." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="1243" value="Reads&#10;&#10;Park Entered and Park Left&#10;&#10;Visitor entered / left park area&#10;&#10;Area visitor count changed&#10;&#10;Attraction entered,&#10;queue entry and exit&#10;&#10;Comparable past days" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="260" height="215" as="geometry"/></mxCell><mxCell id="1244" value="Forecast crowding and&#10;recommend staffing&#10;LLM, beats a baseline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="370" y="205" width="230" height="80" as="geometry"/></mxCell><mxCell id="1245" value="enough recent&#10;counting data?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="1246" value="Abstention recorded&#10;&#10;Happens when the counting&#10;window has gaps, after an&#10;outage or a missing device" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="230" height="90" as="geometry"/></mxCell><mxCell id="1247" value="Crowd Forecast Produced&#10;Staffing Recommended&#10;with confidence and provenance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="280" height="120" as="geometry"/></mxCell><mxCell id="1248" value="Operations Manager&#10;accepts, rejects or corrects,&#10;and the outcome is recorded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="1249" value="Nothing changes&#10;until the manager&#10;acts on it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1520" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="12410" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1243" target="1244"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12411" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1244" target="1245"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12412" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1245" target="1247"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12413" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="1245" target="1246"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12414" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1247" target="1248"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12415" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="1248" target="1249"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12416" value="Cost of being wrong&#10;&#10;Under-staffing or over-staffing for a shift. No safety consequence, because&#10;the crowding response is deterministic and entirely separate from this." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="12417" value="Works without AI&#10;&#10;The Area Capacity Exceeded policy runs at the edge and notifies operations&#10;whether or not a forecast exists (ADR-006). Crowding never waits on a model." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="12418" value="Measured by&#10;&#10;Forecast error against actual counts per area, tested on later weeks than tuned on.&#10;Acceptance rate of staffing recommendations. Works on anonymous counts, see QA-04." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="lg2k" value="Key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#3A3A3A;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1710" height="100" as="geometry"/></mxCell><mxCell id="lg2s0" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="72" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg2t0" value="Recorded facts the use case reads" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg2s1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9BD5F0;strokeColor=#4D8FAD;" vertex="1" parent="1"><mxGeometry x="410" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg2t1" value="AI step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg2s2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="748" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg2t2" value="Decision gate" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg2s3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0F0F0;strokeColor=#8C8C8C;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1086" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg2t3" value="Abstention, recorded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg2s4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFB366;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1424" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg2t4" value="Recommendation event" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1470" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg2s5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2D0;strokeColor=#B99326;" vertex="1" parent="1"><mxGeometry x="72" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg2t5" value="Person who reviews or decides" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg2s6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="410" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg2t6" value="What changes, or what works without AI" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg2s7" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBE3E2;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="748" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg2t7" value="Cost of being wrong" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg2s8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1086" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg2t8" value="How it is measured" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="uc2spec" value="What is specific to UC-2&#10;&#10;Horizon: each area, two hours ahead.&#10;Baseline: the same weekday; the LLM forecast must beat it to ship.&#10;Confidence: the range across five runs. Staffing stays within the manager's limits.&#10;Feedback: actual counts arrive and score every forecast. Advice expires at its shift." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="870" height="145" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC-3 Visitor itinerary"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="9661" value="UC-3  Visitor itinerary recommendation" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="9662" value="The estate needs to grow visitor numbers, and the brief asks for AI that helps customers and not only the company." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="9663" value="Reads&#10;&#10;Published attraction availability&#10;from the Attraction Catalogue&#10;&#10;Current queue lengths&#10;&#10;Crowding forecast from UC-2&#10;&#10;Visitor preferences&#10;where consent exists" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="260" height="190" as="geometry"/></mxCell><mxCell id="9664" value="Recommend itinerary&#10;LLM from the visitor's&#10;own words" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="370" y="205" width="230" height="80" as="geometry"/></mxCell><mxCell id="9665" value="fresh data and&#10;consent present?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="9666" value="Abstention recorded&#10;&#10;The app falls back to the&#10;plain attraction list, which&#10;is not an AI feature" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="230" height="90" as="geometry"/></mxCell><mxCell id="9667" value="Itinerary Recommended&#10;shown in the visitor application" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="280" height="120" as="geometry"/></mxCell><mxCell id="9668" value="The visitor&#10;follows it or ignores it.&#10;No staff review, the&#10;consequence is low." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="9669" value="Advice only.&#10;Nothing operational&#10;changes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;align=center;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1520" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="96610" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9663" target="9664"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96611" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9664" target="9665"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96612" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9665" target="9667"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96613" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="9665" target="9666"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96614" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9667" target="9668"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96615" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="9668" target="9669"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="96616" value="Cost of being wrong&#10;&#10;A mediocre route. An attraction the catalogue shows as closed never appears,&#10;because that is checked deterministically before the itinerary is shown." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="96617" value="Works without AI&#10;&#10;Catalogue availability is authoritative and a safety closure always wins&#10;(FR-AC-05). Without AI the visitor gets the ordinary attraction list." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="96618" value="Measured by&#10;&#10;Judged route quality against a deterministic planner baseline.&#10;An in-app &quot;did you use the route?&quot; question.&#10;100 per cent pass rate on the closed-attraction check." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="lg3k" value="Key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#3A3A3A;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1710" height="100" as="geometry"/></mxCell><mxCell id="lg3s0" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="72" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg3t0" value="Recorded facts the use case reads" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg3s1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9BD5F0;strokeColor=#4D8FAD;" vertex="1" parent="1"><mxGeometry x="410" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg3t1" value="AI step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg3s2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="748" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg3t2" value="Decision gate" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg3s3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0F0F0;strokeColor=#8C8C8C;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1086" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg3t3" value="Abstention, recorded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg3s4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFB366;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1424" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg3t4" value="Recommendation event" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1470" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg3s5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2D0;strokeColor=#B99326;" vertex="1" parent="1"><mxGeometry x="72" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg3t5" value="Person who reviews or decides" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg3s6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="410" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg3t6" value="What changes, or what works without AI" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg3s7" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBE3E2;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="748" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg3t7" value="Cost of being wrong" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="lg3s8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1086" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="lg3t8" value="How it is measured" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="uc3spec" value="What is specific to UC-3&#10;&#10;Preferences: free text in the visitor's own words.&#10;Constraints: open attractions, ages and heights, walking time, forecast queues.&#10;Freshness: availability older than five minutes is shown as unknown, not open.&#10;Guard: a deterministic check removes closed stops before display. No numeric confidence." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="870" height="145" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC-7 Piranha population count"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="u7t" value="UC-7  Piranha population count" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="u7u" value="The brief asks for population levels of the jumping piranha collection. Counting fast-moving fish by eye is slow and inconsistent." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="u7r" value="Reads&#10;&#10;Camera frames over each tank,&#10;processed on the camera&#10;&#10;Keeper spot counts&#10;&#10;Healthy range per tank,&#10;set by the Zookeeper&#10;Staff Manager" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="260" height="215" as="geometry"/></mxCell><mxCell id="u7a" value="Count the fish&#10;vision model on&#10;the edge camera" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="370" y="205" width="230" height="80" as="geometry"/></mxCell><mxCell id="u7g" value="frames agree&#10;on the count?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="u7b" value="Abstention recorded&#10;&#10;Murky water, feeding time,&#10;or frames that disagree" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="230" height="90" as="geometry"/></mxCell><mxCell id="u7e" value="Enclosure Population Counted&#10;count, frame agreement,&#10;model version, time.&#10;Out of range raises a finding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="280" height="120" as="geometry"/></mxCell><mxCell id="u7v" value="Zookeeper Staff Manager&#10;checks an out-of-range tank.&#10;Keepers keep a weekly&#10;spot count" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="u7o" value="A camera count is a&#10;sensor observation.&#10;Only a keeper changes&#10;the recorded population." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="1520" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="u7x1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u7r" target="u7a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u7x2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u7a" target="u7g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u7x3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u7g" target="u7e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u7x4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u7g" target="u7b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u7x5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u7e" target="u7v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u7x6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u7v" target="u7o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u7p1" value="Cost of being wrong&#10;&#10;A wrong count delays noticing a population change, or sends a keeper&#10;to count for nothing. The weekly keeper spot count bounds the delay." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="u7p2" value="Works without AI&#10;&#10;Keepers count the collection on a schedule and record the count&#10;on the staff application (FR-AE-06)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="u7p3" value="Measured by&#10;&#10;Count error against keeper spot counts. Counts stay marked unvalidated&#10;until the error is within 10 per cent for four weeks (proposed).&#10;Days a tank spends outside its healthy range. See ADR-011." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="u7sp" value="What is specific to UC-7&#10;&#10;Runs at the edge: the camera publishes only a count over MQTT (ADR-004).&#10;Frames never leave the camera, so visitors are not recorded (ADR-013).&#10;Several frames per count; disagreement means abstain, never a guess.&#10;The trend per tank, not one count, raises the finding." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="870" height="145" as="geometry"/></mxCell><mxCell id="u7lgk" value="Key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#3A3A3A;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1710" height="100" as="geometry"/></mxCell><mxCell id="u7lgs0" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="72" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u7lgt0" value="Recorded facts the use case reads" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u7lgs1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9BD5F0;strokeColor=#4D8FAD;" vertex="1" parent="1"><mxGeometry x="410" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u7lgt1" value="AI step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u7lgs2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="748" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u7lgt2" value="Decision gate" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u7lgs3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0F0F0;strokeColor=#8C8C8C;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1086" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u7lgt3" value="Abstention, recorded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u7lgs4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFB366;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1424" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u7lgt4" value="Recommendation event" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1470" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u7lgs5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2D0;strokeColor=#B99326;" vertex="1" parent="1"><mxGeometry x="72" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="u7lgt5" value="Person who reviews or decides" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="u7lgs6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="410" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="u7lgt6" value="What changes, or what works without AI" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="u7lgs7" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBE3E2;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="748" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="u7lgt7" value="Cost of being wrong" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="u7lgs8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1086" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="u7lgt8" value="How it is measured" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="752" width="284" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UC-8 Visitor feedback insights"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="u8t" value="UC-8  Visitor feedback insights" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1400" height="30" as="geometry"/></mxCell><mxCell id="u8u" value="The Countess wants more returning visitors but does not know why visitors come back or not, or where to invest." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="u8r" value="Reads&#10;&#10;Anonymous post-visit feedback:&#10;a rating and free text&#10;per attraction&#10;&#10;Attraction names from&#10;the catalogue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="260" height="215" as="geometry"/></mxCell><mxCell id="u8a" value="Group feedback into themes&#10;LLM, after personal&#10;details are removed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#9BD5F0;strokeColor=#4D8FAD;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="370" y="205" width="230" height="80" as="geometry"/></mxCell><mxCell id="u8g" value="runs agree&#10;on the theme?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="u8b" value="Comment left unthemed&#10;&#10;Counted, and still shown&#10;to the reader" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="230" height="90" as="geometry"/></mxCell><mxCell id="u8e" value="Feedback Themes Summarized&#10;weekly per attraction:&#10;theme, count and&#10;example comments" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FFB366;strokeColor=#D79B00;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="280" height="120" as="geometry"/></mxCell><mxCell id="u8v" value="Operations Manager&#10;reads the weekly summary&#10;with example comments" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FDF2D0;strokeColor=#B99326;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="1220" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="u8o" value="Informs staffing and&#10;investment decisions.&#10;Nothing operational&#10;changes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="1520" y="200" width="250" height="100" as="geometry"/></mxCell><mxCell id="u8x1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u8r" target="u8a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u8x2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u8a" target="u8g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u8x3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u8g" target="u8e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u8x4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u8g" target="u8b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u8x5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u8e" target="u8v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u8x6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u8v" target="u8o"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u8p1" value="Cost of being wrong&#10;&#10;A misread priority. Every theme shows real example comments, so the&#10;reader can check the summary against what visitors actually wrote." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;fontColor=#3A1210;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="u8p2" value="Works without AI&#10;&#10;Ratings per attraction are plain averages and need no model.&#10;Comments stay readable as a list." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="u8p3" value="Measured by&#10;&#10;Agreement with a hand-labelled sample each month.&#10;Over time: whether a theme that was acted on is mentioned less,&#10;and the repeat-purchase rate of account holders (business-outcomes.md)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="550" height="150" as="geometry"/></mxCell><mxCell id="u8sp" value="What is specific to UC-8&#10;&#10;No account and no tracking: feedback is anonymous (ADR-013).&#10;Personal details typed into comments are removed before the model sees them.&#10;Confidence: agreement of the theme across five runs (ADR-017).&#10;A weekly batch, so cost stays small and latency does not matter." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="870" height="145" as="geometry"/></mxCell><mxCell id="u8lgk" value="Key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#3A3A3A;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1710" height="100" as="geometry"/></mxCell><mxCell id="u8lgs0" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="72" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u8lgt0" value="Recorded facts the use case reads" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u8lgs1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9BD5F0;strokeColor=#4D8FAD;" vertex="1" parent="1"><mxGeometry x="410" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u8lgt1" value="AI step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u8lgs2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="748" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u8lgt2" value="Decision gate" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u8lgs3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0F0F0;strokeColor=#8C8C8C;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1086" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u8lgt3" value="Abstention, recorded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u8lgs4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFB366;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1424" y="726" width="36" height="18" as="geometry"/></mxCell><mxCell id="u8lgt4" value="Recommendation event" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1470" y="722" width="284" height="26" as="geometry"/></mxCell><mxCell id="u8lgs5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2D0;strokeColor=#B99326;" vertex="1" parent="1"><mxGeometry x="72" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="u8lgt5" value="Person who reviews or decides" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="u8lgs6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="410" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="u8lgt6" value="What changes, or what works without AI" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="456" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="u8lgs7" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBE3E2;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="748" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="u8lgt7" value="Cost of being wrong" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="794" y="752" width="284" height="26" as="geometry"/></mxCell><mxCell id="u8lgs8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1086" y="756" width="36" height="18" as="geometry"/></mxCell><mxCell id="u8lgt8" value="How it is measured" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1132" y="752" width="284" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>