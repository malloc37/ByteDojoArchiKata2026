<mxfile host="app.diagrams.net" type="device" agent="archikata"><diagram name="AI task delivery"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="AI task delivery: from a cloud finding to a keeper, through an outage" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1500" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Read top to bottom. The same path serves every AI finding that needs a person (ADR-006, ADR-007). Identifiers are examples." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="22" as="geometry"/></mxCell><mxCell id="tbe" value="ESTATE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=#EFF7EC;strokeColor=#5E8B4C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#254A18;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="870" height="1130" as="geometry"/></mxCell><mxCell id="tbc" value="CLOUD PLATFORM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=#EAF3FB;strokeColor=#5E87AB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#1D3A55;" vertex="1" parent="1"><mxGeometry x="930" y="80" width="590" height="1130" as="geometry"/></mxCell><mxCell id="tl1" value="" style="html=1;endArrow=none;strokeColor=#9A9A9A;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="184" as="sourcePoint"/><mxPoint x="160" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tp1" value="Zookeeper&#10;local staff application" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2D0;strokeColor=#B99326;fontSize=12;fontColor=#3A2E0B;" vertex="1" parent="1"><mxGeometry x="55" y="120" width="210" height="64" as="geometry"/></mxCell><mxCell id="tl2" value="" style="html=1;endArrow=none;strokeColor=#9A9A9A;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="184" as="sourcePoint"/><mxPoint x="470" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tp2" value="Staff Tasks and Alerts&#10;park service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="365" y="120" width="210" height="64" as="geometry"/></mxCell><mxCell id="tl3" value="" style="html=1;endArrow=none;strokeColor=#9A9A9A;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="184" as="sourcePoint"/><mxPoint x="780" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tp3" value="Cloud Sync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3E9F2;strokeColor=#5A6B80;strokeWidth=2;fontSize=12;fontColor=#1E2A3A;" vertex="1" parent="1"><mxGeometry x="675" y="120" width="210" height="64" as="geometry"/></mxCell><mxCell id="tl4" value="" style="html=1;endArrow=none;strokeColor=#9A9A9A;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="184" as="sourcePoint"/><mxPoint x="1080" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tp4" value="Estate Sync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3E9F2;strokeColor=#5A6B80;strokeWidth=2;fontSize=12;fontColor=#1E2A3A;" vertex="1" parent="1"><mxGeometry x="975" y="120" width="210" height="64" as="geometry"/></mxCell><mxCell id="tl5" value="" style="html=1;endArrow=none;strokeColor=#9A9A9A;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="184" as="sourcePoint"/><mxPoint x="1380" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tp5" value="Estate Insights&#10;AI use cases" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FCE4EF;strokeColor=#C079A0;strokeWidth=2;fontSize=12;fontColor=#4A1F36;" vertex="1" parent="1"><mxGeometry x="1275" y="120" width="210" height="64" as="geometry"/></mxCell><mxCell id="tout" value="Internet outage&#10;The finding waits in the cloud. Estate work, local tasks and the overdue-feeding rule carry on." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#3A1210;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="580" height="90" as="geometry"/></mxCell><mxCell id="tm0" value="1  Finding F-81, expires in 24 hours" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="240" as="sourcePoint"/><mxPoint x="1080" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm1" value="2  Down after reconnection: F-81" style="html=1;endArrow=block;endFill=1;strokeColor=#B06A00;strokeWidth=3;fontSize=11;fontColor=#8A4B00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="400" as="sourcePoint"/><mxPoint x="780" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm2" value="3  F-81" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="450" as="sourcePoint"/><mxPoint x="470" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tn3" value="4  Review policy creates task T-12&#10;    and records F-81 as handled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#3A2E0B;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="335" y="475" width="270" height="50" as="geometry"/></mxCell><mxCell id="tm4" value="5  Inspection task T-12" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="565" as="sourcePoint"/><mxPoint x="160" y="565" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm5" value="6  F-81 again: the acknowledgement was lost" style="html=1;endArrow=block;endFill=1;strokeColor=#B06A00;strokeWidth=3;fontSize=11;fontColor=#8A4B00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="615" as="sourcePoint"/><mxPoint x="780" y="615" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm6" value="7  F-81" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="665" as="sourcePoint"/><mxPoint x="470" y="665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tn7" value="8  Known finding ID: no second task" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#3A2E0B;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="335" y="690" width="270" height="40" as="geometry"/></mxCell><mxCell id="tm8" value="9  Acknowledge, inspect, record: confirmed" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="770" as="sourcePoint"/><mxPoint x="470" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm9" value="10  Task and inspection events" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="820" as="sourcePoint"/><mxPoint x="780" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm10" value="11  Up: events, sequence per stream" style="html=1;endArrow=block;endFill=1;strokeColor=#B06A00;strokeWidth=3;fontSize=11;fontColor=#8A4B00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="870" as="sourcePoint"/><mxPoint x="1080" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm11" value="12  Review outcome for evaluation (ADR-011)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="920" as="sourcePoint"/><mxPoint x="1380" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm12" value="13  Staffing advice S-4 for the 10:00 shift" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="985" as="sourcePoint"/><mxPoint x="1080" y="985" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm13" value="14  Delivered at 11:30, after it expired" style="html=1;endArrow=block;endFill=1;strokeColor=#B06A00;strokeWidth=3;fontSize=11;fontColor=#8A4B00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="1035" as="sourcePoint"/><mxPoint x="780" y="1035" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tm14" value="15  S-4" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="1085" as="sourcePoint"/><mxPoint x="470" y="1085" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tn15" value="16  Recorded as expired. No task." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#3A2E0B;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="335" y="1110" width="270" height="40" as="geometry"/></mxCell><mxCell id="trules" value="Rules this shows (ADR-007)&#10;&#10;Every finding carries an ID, its provenance and an expiry time.&#10;&#10;Staff Tasks at the estate creates the task and owns it.&#10;&#10;A redelivered finding creates no second task.&#10;&#10;An expired finding is recorded and creates no task.&#10;&#10;Task and review outcomes flow back up as events." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1560" y="120" width="330" height="330" as="geometry"/></mxCell><mxCell id="tlgk" value="Key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#3A3A3A;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1560" y="480" width="330" height="280" as="geometry"/></mxCell><mxCell id="tlgs0" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2D0;strokeColor=#B99326;" vertex="1" parent="1"><mxGeometry x="1572" y="516" width="36" height="18" as="geometry"/></mxCell><mxCell id="tlgt0" value="Person" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1618" y="512" width="256" height="26" as="geometry"/></mxCell><mxCell id="tlgs1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1572" y="546" width="36" height="18" as="geometry"/></mxCell><mxCell id="tlgt1" value="Estate module" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1618" y="542" width="256" height="26" as="geometry"/></mxCell><mxCell id="tlgs2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E3E9F2;strokeColor=#5A6B80;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1572" y="576" width="36" height="18" as="geometry"/></mxCell><mxCell id="tlgt2" value="Sync module" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1618" y="572" width="256" height="26" as="geometry"/></mxCell><mxCell id="tlgs3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FCE4EF;strokeColor=#C079A0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1572" y="606" width="36" height="18" as="geometry"/></mxCell><mxCell id="tlgt3" value="AI module" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1618" y="602" width="256" height="26" as="geometry"/></mxCell><mxCell id="tlgs4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1572" y="636" width="36" height="18" as="geometry"/></mxCell><mxCell id="tlgt4" value="Step inside one participant" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1618" y="632" width="256" height="26" as="geometry"/></mxCell><mxCell id="tlgs5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1572" y="666" width="36" height="18" as="geometry"/></mxCell><mxCell id="tlgt5" value="Period without internet" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1618" y="662" width="256" height="26" as="geometry"/></mxCell><mxCell id="tlgs6" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1572" y="705" as="sourcePoint"/><mxPoint x="1608" y="705" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tlgt6" value="On the local network or inside the cloud" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1618" y="692" width="256" height="26" as="geometry"/></mxCell><mxCell id="tlgs7" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#B06A00;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1572" y="735" as="sourcePoint"/><mxPoint x="1608" y="735" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tlgt7" value="Over the estate-cloud WebSocket" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1618" y="722" width="256" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>