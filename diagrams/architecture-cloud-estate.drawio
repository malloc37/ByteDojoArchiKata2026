<mxfile host="app.diagrams.net" type="device" agent="archikata"><diagram name="Two services"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="Von Digitalis Estate, two services" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1900" height="30" as="geometry"/></mxCell><mxCell id="b2" value="The cloud platform and the park service are each a modular monolith with their own event log (ADR-009, ADR-016, ADR-005). They exchange events over one WebSocket connection (ADR-007). Names describe capability, not product." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1940" height="22" as="geometry"/></mxCell><mxCell id="b3" value="Payment Provider&#10;&lt;i style='font-size:11px'&gt;external&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="265" width="180" height="62" as="geometry"/></mxCell><mxCell id="b4" value="AI model provider&#10;&lt;i style='font-size:11px'&gt;external, replaceable&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8C8C8C;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="496" width="180" height="62" as="geometry"/></mxCell><mxCell id="b5" value="Visitor website and application" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="315" height="56" as="geometry"/></mxCell><mxCell id="b6" value="CLOUD PLATFORM  (system of record)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EAF3FB;strokeColor=#5E87AB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#1D3A55;" vertex="1" parent="1"><mxGeometry x="280" y="180" width="720" height="725" as="geometry"/></mxCell><mxCell id="b7" value="Modules, one per bounded context. One deployable, modular monolith (ADR-009)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F7FBFF;strokeColor=#8FB0CC;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#2B4A66;" vertex="1" parent="1"><mxGeometry x="300" y="225" width="680" height="360" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;Ticketing&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;products, purchase, issuance&lt;br&gt;holds the only account store (ADR-013)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="315" y="265" width="320" height="62" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Attraction Catalogue&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;descriptions, published availability&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="650" y="265" width="315" height="62" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;Admission and Visitor Flow&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;admission history, visitor counts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="315" y="339" width="320" height="62" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;Ride Operations&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;inspection and fault history&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="650" y="339" width="315" height="62" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;Animal and Enclosure Care&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;care records, animal history&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="315" y="413" width="320" height="62" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;Staff Tasks and Alerts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;AI review tasks, task history&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="650" y="413" width="315" height="62" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;Estate Insights and AI Decision Support&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;UC-1 animal health, UC-2 crowd and staffing, UC-3 itinerary&lt;br&gt;golden sets and review monitoring (ADR-011)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#FCE4EF;strokeColor=#C079A0;strokeWidth=2;fontColor=#4A1F36;" vertex="1" parent="1"><mxGeometry x="315" y="487" width="650" height="80" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;Cloud event log&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;append-only, authoritative&lt;br&gt;module state is a projection&lt;/span&gt;" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;size=10;" vertex="1" parent="1"><mxGeometry x="300" y="620" width="320" height="100" as="geometry"/></mxCell><mxCell id="b16" value="&lt;b&gt;Estate Sync&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;supporting module, not a bounded context&lt;br&gt;deduplicates by event ID, assigns position,&lt;br&gt;acknowledges, pushes cache updates&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#E3E9F2;strokeColor=#5A6B80;strokeWidth=2;fontColor=#1E2A3A;" vertex="1" parent="1"><mxGeometry x="660" y="620" width="320" height="100" as="geometry"/></mxCell><mxCell id="b17" value="No module reads another module's tables. Modules learn what happened only from published domain events, and a command crosses a boundary only as a policy reaction to an event (ADR-005)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#3A3A3A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="830" width="680" height="60" as="geometry"/></mxCell><mxCell id="b18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.746;entryY=0;" edge="1" parent="1" source="b5" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b19" value="hosted checkout,&#10;signed callbacks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b8" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b20" value="task-shaped&#10;requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b14" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b21" value="publish and&#10;consume events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=blockThin;startFill=1;exitX=0.235;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b7" target="b15"><mxGeometry x="0.1" relative="1" as="geometry"/></mxCell><mxCell id="b22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=blockThin;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b15" target="b16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b23" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;cloud instance, staff only, authoritative&lt;br&gt;for staff identities and roles (ADR-012)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D9F2EE;strokeColor=#3E8E82;strokeWidth=2;fontColor=#123A34;" vertex="1" parent="1"><mxGeometry x="300" y="748" width="320" height="62" as="geometry"/></mxCell><mxCell id="b24" value="staff IDs and roles,&#10;one way" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="b23" target="b16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="779"/></Array></mxGeometry></mxCell><mxCell id="b25" value="ESTATE  (keeps working during an internet outage)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#EFF7EC;strokeColor=#5E8B4C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#254A18;" vertex="1" parent="1"><mxGeometry x="1180" y="180" width="820" height="800" as="geometry"/></mxCell><mxCell id="b26" value="Park service on the Estate Edge Hub. Second deployable, modular monolith (ADR-016)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F7FCF5;strokeColor=#86B272;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#2F5A20;" vertex="1" parent="1"><mxGeometry x="1200" y="225" width="780" height="520" as="geometry"/></mxCell><mxCell id="b27" value="Operational core modules" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#A9C89B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#3E5C33;" vertex="1" parent="1"><mxGeometry x="1215" y="265" width="750" height="235" as="geometry"/></mxCell><mxCell id="b28" value="&lt;b&gt;Admission and Visitor Flow&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;admissions, reuse detection, area counts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="1230" y="300" width="355" height="56" as="geometry"/></mxCell><mxCell id="b29" value="&lt;b&gt;Ride Operations&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;fault policy, safety closure (ADR-006)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="1600" y="300" width="350" height="56" as="geometry"/></mxCell><mxCell id="b30" value="&lt;b&gt;Animal and Enclosure Care&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;feeding, inspections, overdue-feeding rule&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="1230" y="366" width="355" height="56" as="geometry"/></mxCell><mxCell id="b31" value="&lt;b&gt;Staff Tasks and Alerts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;local tasks and safety alerts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#13290F;" vertex="1" parent="1"><mxGeometry x="1600" y="366" width="350" height="56" as="geometry"/></mxCell><mxCell id="b32" value="&lt;b&gt;Local estate view and API&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;serves the local staff application&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="1230" y="432" width="720" height="52" as="geometry"/></mxCell><mxCell id="b33" value="&lt;b&gt;Cloud Sync&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;supporting module, not a bounded context&lt;br&gt;sequence per stream, stores the last ack,&lt;br&gt;resumes after an outage&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#E3E9F2;strokeColor=#5A6B80;strokeWidth=2;fontColor=#1E2A3A;" vertex="1" parent="1"><mxGeometry x="1215" y="620" width="345" height="100" as="geometry"/></mxCell><mxCell id="b34" value="&lt;b&gt;Local event log&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;lightweight local database&lt;br&gt;pending events, cached keys,&lt;br&gt;rules and daily plans&lt;/span&gt;" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#3A2608;size=10;" vertex="1" parent="1"><mxGeometry x="1590" y="620" width="280" height="100" as="geometry"/></mxCell><mxCell id="b35" value="&lt;b&gt;Local MQTT broker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;on the Estate Edge Hub, device events&lt;br&gt;to the operational modules (ADR-004)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#2A1733;" vertex="1" parent="1"><mxGeometry x="1215" y="770" width="295" height="66" as="geometry"/></mxCell><mxCell id="b36" value="&lt;b&gt;LoRaWAN sensors&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;via gateways and&lt;br&gt;local Network Server&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#3A1210;" vertex="1" parent="1"><mxGeometry x="1195" y="880" width="190" height="76" as="geometry"/></mxCell><mxCell id="b37" value="&lt;b&gt;Edge cameras&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;publish derived&lt;br&gt;counts only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#3A1210;" vertex="1" parent="1"><mxGeometry x="1397" y="880" width="190" height="76" as="geometry"/></mxCell><mxCell id="b38" value="&lt;b&gt;Gates&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;verify signed tickets&lt;br&gt;offline (ADR-008)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#3A1210;" vertex="1" parent="1"><mxGeometry x="1599" y="880" width="190" height="76" as="geometry"/></mxCell><mxCell id="b39" value="&lt;b&gt;Local staff application&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;keepers, mechanics,&lt;br&gt;operations&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="1801" y="880" width="190" height="76" as="geometry"/></mxCell><mxCell id="b40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=