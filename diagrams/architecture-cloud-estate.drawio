><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b46" value="sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.25;exitY=0;entryX=0.59;entryY=1;" edge="1" parent="1" source="b39" target="b44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b47" value="commands and queries&#10;over the local network" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=blockThin;startFill=1;exitX=0.679;exitY=0;entryX=0.972;entryY=1;" edge="1" parent="1" source="b39" target="b32"><mxGeometry x="0.45" relative="1" as="geometry"/></mxCell><mxCell id="b48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0;exitY=0.5;entryX=0;entryY=0.498;" edge="1" parent="1" source="b35" target="b27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1193" y="803"/><mxPoint x="1193" y="382"/></Array></mxGeometry></mxCell><mxCell id="b49" value="publish and&#10;consume events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=blockThin;startFill=1;exitX=0.687;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b27" target="b34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=blockThin;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b33" target="b34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#B06A00;strokeWidth=4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b16" target="b33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b52" value="&lt;b&gt;One WebSocket&lt;br&gt;connection&lt;/b&gt;&lt;br&gt;(ADR-007)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=12;fontColor=#8A4B00;" vertex="1" parent="1"><mxGeometry x="1005" y="560" width="170" height="100" as="geometry"/></mxCell><mxCell id="b53" value="Up: domain events,&lt;br&gt;sequence per stream&lt;br&gt;&lt;br&gt;Down: keys, rules,&lt;br&gt;daily plans, staff roles,&lt;br&gt;versioned&lt;br&gt;&lt;br&gt;Cumulative acks.&lt;br&gt;Both sides resume&lt;br&gt;after an outage." style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#8A4B00;" vertex="1" parent="1"><mxGeometry x="1005" y="685" width="170" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>