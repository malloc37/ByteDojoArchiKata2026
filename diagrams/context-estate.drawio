<mxfile host="app.diagrams.net" type="device" agent="archikata"><diagram name="Estate context"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="es1" value="Von Digitalis Estate - system context" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="30" as="geometry"/></mxCell><mxCell id="es2" value="Who uses the estate platform, and what it depends on. Grey boxes are outside our control." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1200" height="22" as="geometry"/></mxCell><mxCell id="es3" value="Von Digitalis Estate platform" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FBFBFD;strokeColor=#444444;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=16;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="640" height="652" as="geometry"/></mxCell><mxCell id="es4" value="CLOUD  -  authoritative system of record" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EAF3FB;strokeColor=#5E87AB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1D3A55;" vertex="1" parent="1"><mxGeometry x="450" y="180" width="580" height="240" as="geometry"/></mxCell><mxCell id="es5" value="ESTATE  -  keeps working during an internet outage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EFF7EC;strokeColor=#5E8B4C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#254A18;" vertex="1" parent="1"><mxGeometry x="450" y="480" width="580" height="262" as="geometry"/></mxCell><mxCell id="e