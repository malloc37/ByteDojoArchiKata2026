<mxfile host="app.diagrams.net" type="device" agent="archikata"><diagram name="Connectivity tiers"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="co1" value="Estate connectivity - one tier per job" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="30" as="geometry"/></mxCell><mxCell id="co2" value="Wi-Fi coverage is patchy. Devices whose work cannot fail do not depend on radio." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1200" height="22" as="geometry"/></mxCell><mxCell id="co3" value="Remote low-data sensors&#10;&lt;i style='font-size:11px'&gt;animal, enclosure and environment readings&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#3A1210;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="330" height="90" as="geometry"/></mxCell><mxCell id="co4" value="Fixed installations&#10;&lt;i style='font-size:11px'&gt;gates, ride controls, care terminals, edge cameras&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#3A1210;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="330" height="90" as="geometry"/></mxCell><mxCell id="co5" value="Staff phones and tablets&#10;&lt;i style='font-size:11px'&gt;keepers, mechanics, operations&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="330" height="90" as="geometry"/></mxCell><mxCell id="co6" value="Offline outbox on the device&#10;&lt;i style='font-size:11px'&gt;holds events until the device reconnects, then syncs to the Edge Hub&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=middle;fillColor=#F7F7F7;strokeColor=#8C8C8C;dashed=1;dashPattern=8 4;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="645" width="330" height="80" as="geometry"/></mxCell><mxCell id="co7" value="LoRaWAN gateways&#10;&lt;i style='font-size:11px'&gt;local Network Server&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#2A1733;" vertex="1" parent="1"><mxGeometry x="480" y="165" width="200" height="60" as="geometry"/></mxCell><mxCell id="co8" value="Estate Edge Hub&#10;&lt;i style='font-size:11px'&gt;park service, local MQTT broker, Cloud Sync&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#2A1733;" vertex="1" parent="1"><mxGeometry x="800" y="320" width="330" height="110" as="geometry"/></mxCell><mxCell id="co9" value="Cloud" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#12223A;" vertex="1" parent="1"><mxGeometry x="1270" y="345" width="190" height="60" as="geometry"/></mxCell><mxCell id="co10" value="LoRaWAN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="co3" target="co7"><mxGeometry x="-0.35" relative="1" as="geometry"/></mxCell><mxCell id="co11" value="Ethernet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="co7" target="co8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="195"/><mxPoint x="730" y="342"/></Array></mxGeometry></mxCell><mxCell id="co12" value="Ethernet or PoE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="co4" target="co8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="co13" value="Estate Wi-Fi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="co5" target="co8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="555"/><mxPoint x="760" y="408"/></Array></mxGeometry></mxCell><mxCell id="co14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;dashPattern=8 4;endArrow=none;strokeColor=#8C8C8C;" edge="1" parent="1" source="co5" target="co6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="co15" value="WebSocket&#10;(ADR-007)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=blockThin;endFill=1;strokeColor=#B06A00;strokeWidth=2;dashed=1;dashPattern=8 5;labelBackgroundColor=#FFFFFF;fontColor=#8A4B00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=blockThin;startFill=1;" edge="1" parent="1" source="co8" target="co9"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell><mxCell id="co16" value="MQTT improves delivery and reconnection behaviour.&#10;It does not repair missing Wi-Fi coverage." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontColor=#4A3708;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="505" width="400" height="70" as="geometry"/></mxCell><mxCell id="co17" value="Why the tiers differ&#10;&#10;•  Ethernet or PoE for anything safety-critical: gates, ride controls, gateways, fixed care terminals and the Edge Hub.&#10;    These must not depend on radio coverage.&#10;&#10;•  Estate Wi-Fi for staff phones. Convenient, but coverage is patchy, so every staff device keeps a local outbox.&#10;&#10;•  LoRaWAN for remote low-data sensors. Long range and battery life matter more than bandwidth.&#10;    Gateways reach a local Network Server, which publishes each reading onto the local MQTT broker.&#10;&#10;•  Edge cameras process images locally and publish only derived counts over the local network.&#10;&#10;•  A device with no network path stores events locally. Until it reconnects, other staff cannot see them.&#10;&#10;•  Safety-critical work needs reliable coverage, a fixed terminal, or a manual fallback procedure." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#3A3A3A;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="1400" height="265" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>